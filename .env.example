# Mock development mode (MSW)
# VITE_API_BASE_URL=/api/v1
# VITE_ENABLE_MOCKS=true

# Local Django backend (bomach_os_backend)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_ENABLE_MOCKS=false

# Optional notification endpoint overrides. Leave unset to use the standard
# Bomach API routes.
# VITE_NOTIFICATION_LIST_PATH=/notifications/
# VITE_NOTIFICATION_MARK_READ_PATH=/notifications/{id}/read
# VITE_NOTIFICATION_MARK_ALL_READ_PATH=/notifications/read-all

# Real deployed backend
